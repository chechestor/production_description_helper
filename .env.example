# Скопируйте этот файл в .env и впишите только OPENAI_API_KEY.
# Переменные окружения имеют приоритет над значениями из .env.

# Ключ OpenAI. Вписывает владелец, в git не попадает (.env в .gitignore).
OPENAI_API_KEY=

# Модель генерации (OpenAI, с поддержкой structured output)
LLM_MODEL=gpt-4.1-mini
# Таймаут вызова модели, секунды
LLM_TIMEOUT=60

# Phoenix: адрес приёма трасс (имя сервиса в Docker Compose) и имя проекта.
# Пустой адрес отключает трассировку. Для запуска без Docker: http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
PHOENIX_PROJECT_NAME=product-description-helper

# SQLite с сессиями входа; папка data/ монтируется в контейнер
DATABASE_PATH=data/app.db
# Срок жизни сессии входа, часы
SESSION_TTL_HOURS=168

# Единственный пользователь. user/user — только для локальной проверки.
AUTH_LOGIN=user
AUTH_PASSWORD=user

# Порты наружу
FRONTEND_PORT=3000
BACKEND_PORT=8000
PHOENIX_PORT=6006
